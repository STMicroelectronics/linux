if ARCH_STM32 || COMPILE_TEST

config STM32MP_PM_DOMAIN
	tristate "STM32MP PM domain"
	select PM_GENERIC_DOMAINS
	default y
	help
	  Enable support for the STM32MP Power Management (PM) domain driver.
	  This driver implements a generic PM domain for STM32MP SoCs, allowing
	  the kernel to manage power domains for various hardware blocks using
	  the generic power management framework. It is typically used to
	  control the power state of devices and peripherals on STM32MP
	  platforms. If unsure, say Y.

config STM32_HOG
	tristate "STM32 hog"
	default y
	help
	  Say Y here to enable the STM32 hog driver, which prepares and enables
	  a set of clocks very early during kernel initialization. The driver
	  retrieves all clocks referenced by its device node and keeps them
	  enabled for the whole lifetime of the platform device. This is
	  typically used to ensure that critical peripherals or SoC resources
	  remain clocked even if no functional driver has claimed them yet.

config STM32_PM_DOMAINS
	bool "STM32 PM domains"
	depends on MACH_STM32MP157
	select PM_GENERIC_DOMAINS
	default y if MACH_STM32MP157
	help
	  Enable support for STM32 Power Management (PM) domains.
	  This option allows the kernel to manage power domains on STM32MP157
	  platforms, providing runtime power management for various hardware
	  blocks. If unsure, say Y.

config STM32_RISAB
	tristate "STM32 RISAB"
	depends on ARM64 && DEBUG_FS
	default y
	help
	  Say y to enable RISAB dump debug helper driver. This creates an entry
	  in the debugfs to dump RISAB pages and blocks configurations. It
	  implicitly requires that the RISAB is clocked by a capable software
	  component.

config STM32_RISAF
	tristate "STM32 RISAF"
	depends on ARM64 && DEBUG_FS
	default y
	help
	  Say y to enable RISAF dump debug helper driver. This creates an entry
	  in the debugfs to dump RISAF memory regions configurations and
	  topology. It implicitly requires that the RISAF is clocked by a
	  capable software component.

endif # ARCH_STM32 || COMPILE_TEST
